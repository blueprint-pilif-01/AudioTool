# PostgreSQL 18 database created in pgAdmin. Never commit the real password.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/audio_tool

# API and browser
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Local development storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_BYTES=524288000
MAX_AUDIO_DURATION_MS=7200000
TEMP_FILE_TTL_HOURS=24
PROJECT_RETENTION_DAYS=30
CLEANUP_INTERVAL_MINUTES=60

# Jobs. Use inline for zero-dependency development or bullmq with Redis.
QUEUE_MODE=inline
REDIS_URL=redis://localhost:6379

# ML provider. mock never claims to perform real separation.
# mock | demucs_http | banquet_http | sam_audio_http | audiosep_http
ML_PROVIDER=mock
ML_WORKER_URL=http://localhost:8000
# Real CPU separation can take many minutes for long tracks.
ML_REQUEST_TIMEOUT_MS=1800000

# High-quality guide voice. Auto prefers Groq when configured, then Edge neural via the ML worker,
# and uses Windows speech only as the final offline fallback.
GUIDE_TTS_PROVIDER=auto
GROQ_API_KEY=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# Optional Python worker settings (read by apps/ml-worker)
AUDIOTOOL_ML_MODEL=htdemucs_6s
AUDIOTOOL_ML_VOCAL_MODEL=htdemucs_ft
AUDIOTOOL_ML_CACHE_ROOT=./ml-cache
AUDIOTOOL_ML_MAX_UPLOAD_BYTES=524288000
AUDIOTOOL_ML_TIMEOUT_SECONDS=1800
AUDIOTOOL_ML_CONCURRENCY=1
AUDIOTOOL_ML_SHIFTS=0

# Audio executables
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_ROOT=./tmp
